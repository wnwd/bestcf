# Cloudflare API token with "Zone - DNS - Edit" permission covering EVERY
# zone listed in targets.conf (one token can cover many zones).
# Create it in the Cloudflare dashboard (My Profile -> API Tokens -> template
# "Edit zone DNS"). Never use the Global API Key.
CF_API_TOKEN=

# Which records get which IPs is defined in targets.conf (record / zone /
# group per line) — see that file. Records are DNS-only (grey cloud) by
# design: see CF_PROXIED below.

# TTL in seconds (120 is a good balance; 1 = automatic).
CF_TTL=120

# Qualification for the distribution pool: zero packet loss, latency at most
# LATENCY_FACTOR x the round's best latency, and never above this hard cap.
MAX_LATENCY_MS=300
LATENCY_FACTOR=2

# Must stay false: a proxied (orange-cloud) record would resolve to Cloudflare
# anycast addresses instead of the selected best IP.
CF_PROXIED=false

# Seconds between runs. 0 = run once and exit (for cron / systemd-timer use).
RUN_INTERVAL=3600

# Extra flags passed to cfst. Do NOT add -o (the script sets the output file).
# -dn controls how many IPs get a download test — the distribution pool is
# drawn from these, so keep it comfortably above the number of groups.
CFST_ARGS=-dn 10
